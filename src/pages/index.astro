---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Figure from '../components/Figure.astro';
import { SITE } from '../lib/site';
import portrait from '../assets/images/about/portrait.svg';

const featured = (await getCollection('projects', ({ data }) => data.cleared && data.featured))
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || b.data.dates.localeCompare(a.data.dates))
  .slice(0, 3);

// Starfield for the hero, generated once at build time as box-shadow offsets
// (no client-side JS). Seeded so every build produces the same sky.
function seeded(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (s * 1664525 + 1013904223) >>> 0;
    return s / 0x100000000;
  };
}
function stars(count: number, seed: number, w = 1600, h = 520): string {
  const rnd = seeded(seed);
  const out: string[] = [];
  for (let i = 0; i < count; i++) {
    out.push(`${Math.round(rnd() * w)}px ${Math.round(rnd() * h)}px`);
  }
  return out.join(', ');
}
const near = stars(70, 20260710);
const far = stars(140, 19860321);
---

<Base title={SITE.title}>
  <section class="hero intro">
    <div class="sky" aria-hidden="true">
      <i class="stars-far" style={`box-shadow: ${far};`}></i>
      <i class="stars" style={`box-shadow: ${near};`}></i>
      <i class="meteor"></i>
    </div>
    <div class="prose">
      <h1>Dang Khoa Huynh</h1>
      <p>
        I am a third-year Mechatronics with Space Engineering student at the University of Sydney. I design,
        build and test flight and ground electronics: PCBs, firmware and cable harnesses for rocket payloads,
        launch-pad control systems and an electric race car.
      </p>
      <p>TODO: one more sentence if wanted, drafted and reviewed by me.</p>
      <ul class="intro-links">
        <li><a href="/resume.pdf">Resume (PDF)</a></li>
        <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
        <li><a href={`mailto:${SITE.email}`}>Email</a></li>
      </ul>
    </div>
    <Figure
      src={portrait}
      alt="TODO: portrait photo of Dang Khoa Huynh"
      loading="eager"
      widths={[320, 640]}
      sizes="(min-width: 720px) 16rem, 100vw"
    />
  </section>

  <section>
    <h2>Selected projects</h2>
    {featured.length > 0 ? (
      <ul class="cards">{featured.map((p) => <ProjectCard project={p} />)}</ul>
    ) : (
      <p class="muted">
        Project pages are being prepared. See <a href="/now/">what I am working on now</a>.
      </p>
    )}
  </section>
</Base>
