---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

// Only cleared projects (CLAUDE.md A1). Sort by order, then dates descending.
const projects = (await getCollection('projects', ({ data }) => data.cleared)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99) || b.data.dates.localeCompare(a.data.dates),
);
---

<Base
  title="Projects"
  description="Hardware projects by Dang Khoa Huynh: rocket payload electronics, launch-pad control systems and electric race car electronics."
>
  <h1>Projects</h1>
  {projects.length > 0 ? (
    <ul class="cards">{projects.map((p) => <ProjectCard project={p} />)}</ul>
  ) : (
    <p class="muted prose">
      Project pages are being prepared. See <a href="/now/">what I am working on now</a>.
    </p>
  )}
</Base>
