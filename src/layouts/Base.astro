---
import '../styles/global.css';
import { SITE, NAV, entityEncode, formatDate } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  /** Extra class for <main>. */
  mainClass?: string;
}

const { title, description = SITE.description, mainClass = '' } = Astro.props;
const pageTitle = title === SITE.title ? SITE.title : `${title} – ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const now = new Date();
const built = formatDate(now);

const mailto = entityEncode('mailto:' + SITE.email);
const emailText = entityEncode(SITE.email);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">{SITE.name}</a>
        <nav aria-label="Main">
          <ul class="nav">
            {NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main class={`wrap ${mainClass}`.trim()}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>{SITE.name}</div>
        <ul>
          <li><Fragment set:html={`<a href="${mailto}">${emailText}</a>`} /></li>
          <li><a href={SITE.linkedin} rel="me noopener">LinkedIn</a></li>
          <li><a href={SITE.github} rel="me noopener">GitHub</a></li>
        </ul>
        <div>Last updated <time datetime={now.toISOString().slice(0, 10)}>{built}</time></div>
      </div>
    </footer>
  </body>
</html>
