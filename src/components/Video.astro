---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

// Self-hosted video with a poster frame and a required caption. No autoplay and
// preload="none", so nothing downloads until the visitor presses play.
interface Props {
  /** URL from an import of a file in src/assets/media/<slug>/ (Vite emits it). */
  src: string;
  poster: ImageMetadata;
  /** Short description of what the video shows, for screen readers. */
  label: string;
  caption: string;
  n?: number;
  width: number;
  height: number;
}

const { src, poster, label, caption, n, width, height } = Astro.props;
if (!label.trim() || !caption.trim()) throw new Error(`Video: label and caption are required (${src})`);
const posterImg = await getImage({ src: poster, width: Math.min(poster.width, 960), format: 'webp' });
---

<figure class="figure video">
  <video controls preload="none" playsinline poster={posterImg.src} width={width} height={height} aria-label={label}>
    <source src={src} type="video/mp4" />
    <a href={src}>Download the video (MP4)</a>.
  </video>
  <figcaption>
    {n !== undefined && <span class="fig-n">Video {n}.</span>}
    {' '}
    {caption}
  </figcaption>
</figure>
