---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

// Image with a required caption and alt text. Alt must describe the hardware,
// not say "image of board" (CLAUDE.md A5). An empty alt fails the build.
interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Figure number, shown in bold before the caption. */
  n?: number;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  caption,
  n,
  widths = [480, 800, 1200],
  sizes = '(min-width: 72rem) 68ch, 100vw',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

if (!alt || !alt.trim()) {
  throw new Error(`Figure: alt text is required (image ${src.src})`);
}
---

<figure class={`figure ${className}`.trim()}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
  {caption && (
    <figcaption>
      {n !== undefined && <span class="fig-n">Figure {n}.</span>}
      {' '}
      {caption}
    </figcaption>
  )}
</figure>
